{
  "name": "specline",
  "version": "2.3.0",
  "description": "Spec-driven AI coding pipeline with deterministic quality gates for Cursor IDE",
  "bin": {
    "specline": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "lib/",
    "core/",
    "adapters/",
    "templates/",
    "docs/diagram-runtime.md",
    "docs/knowledge/howtos/local-drawio-diagrams.md"
  ],
  "keywords": [
    "cursor",
    "specline",
    "spec-driven",
    "ai-coding",
    "pipeline",
    "agent-orchestration",
    "deterministic-gates",
    "dev-pipeline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RayChou1221/specline"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:update-sync": "node --test tests/cli-update-sync.test.mjs",
    "test:diagram": "node --test tests/unit/diagram/*.test.mjs tests/diagram-production.test.mjs",
    "verify:diagram-production": "node --test tests/diagram-production.test.mjs"
  }
}
