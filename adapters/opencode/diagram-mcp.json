{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "specline-diagram": {
      "type": "local",
      "command": [
        "specline",
        "diagram",
        "mcp",
        "--stdio"
      ],
      "enabled": true,
      "environment": {
        "SPECLINE_MANAGED_MCP": "specline-diagram"
      },
      "timeout": 10000
    }
  }
}
